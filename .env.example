# Copy to .env — every value is optional; the app runs locally with defaults.
PORT=4100
# Public base URL used in click-tracking and unsubscribe links. Tracking only
# works for real recipients if this is reachable from the internet.
PUBLIC_URL=http://localhost:4100
# Where the SQLite database and the encryption key live.
DATA_DIR=./data
# 32+ char secret used to encrypt mailbox credentials at rest. If unset, a key
# file is generated at DATA_DIR/secret.key (back it up — losing it loses credentials).
APP_SECRET=
# Claude API key for the AI assistant. Without it, AI features are disabled
# (heuristic linting still works).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# SMTP mailbox probing (RCPT TO, never sends mail). Needs outbound port 25,
# which most home ISPs and clouds block. off | on
SMTP_PROBE=off
SMTP_PROBE_HELO=
SMTP_PROBE_FROM=
# DNS: system | doh (DNS-over-HTTPS via Cloudflare/Google)
DNS_MODE=system
# OAuth (optional). Without these, connect Gmail/Outlook using app passwords.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Scheduler
SCHEDULER=on
TICK_SECONDS=30
INBOX_SYNC_SECONDS=120
DOMAIN_MONITOR_HOURS=6
# Physical postal address appended to every email (CAN-SPAM requires one).
SENDER_POSTAL_ADDRESS=
